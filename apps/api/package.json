{
  "name": "@mvp-transporte/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --experimental-strip-types --watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.prisma.json",
    "test": "prisma generate && node --experimental-strip-types --test",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@mvp-transporte/contracts": "0.1.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "cors": "2.8.6",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "prisma": "7.10.0"
  }
}
