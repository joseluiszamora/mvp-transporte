generator client {
  provider = "prisma-client"
  output   = "../src/prisma/generated"
}

datasource db {
  provider = "postgresql"
}

enum RecordStatus {
  ACTIVE
  INACTIVE

  @@map("record_status")
}

enum DocumentOwnerType {
  VEHICLE
  EMPLOYEE

  @@map("document_owner_type")
}

enum DocumentStatus {
  CURRENT
  SUPERSEDED

  @@map("document_status")
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE

  @@map("maintenance_type")
}

enum MaintenanceRecordStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("maintenance_record_status")
}

enum FuelType {
  GASOLINE
  GNV

  @@map("fuel_type")
}

enum FuelUnit {
  LITER
  CUBIC_METER
  KILOGRAM

  @@map("fuel_unit")
}

enum TripType {
  DISTRIBUTION
  SHORT_ROUTE
  LONG_DISTANCE

  @@map("trip_type")
}

enum TripStatus {
  PLANNED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("trip_status")
}

enum TripCrewRole {
  DRIVER
  ASSISTANT

  @@map("trip_crew_role")
}

enum TripCrewSource {
  INTERNAL
  CLIENT

  @@map("trip_crew_source")
}

enum TripEventType {
  CREATED
  ASSIGNMENT_CHANGED
  ASSIGNED
  STARTED
  COMPLETED
  CANCELLED

  @@map("trip_event_type")
}

model Vehicle {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  companyId       String       @map("company_id") @db.Uuid
  branchId        String?      @map("branch_id") @db.Uuid
  plate           String       @db.VarChar(20)
  plateNormalized String       @map("plate_normalized") @db.VarChar(20)
  vehicleType     String       @map("vehicle_type") @db.VarChar(40)
  make            String       @db.VarChar(80)
  model           String       @db.VarChar(80)
  year            Int?
  capacityKg      Decimal      @map("capacity_kg") @db.Decimal(12, 2)
  odometerKm      Int?         @map("odometer_km")
  status          RecordStatus @default(ACTIVE)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  documents       ResourceDocument[]
  maintenancePlans MaintenancePlan[]
  maintenanceRecords MaintenanceRecord[]
  fuelTanks       VehicleFuelTank[]
  fuelRecords     FuelRecord[]
  trips           Trip[]

  @@unique([companyId, plateNormalized], map: "vehicles_company_plate_normalized_key")
  @@index([organizationId, companyId, status], map: "vehicles_scope_status_idx")
  @@index([organizationId, companyId, vehicleType], map: "vehicles_scope_type_idx")
  @@map("vehicles")
}

model DriverProfile {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  companyId      String       @map("company_id") @db.Uuid
  employeeId     String       @map("employee_id") @db.Uuid
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([companyId, employeeId], map: "driver_profiles_company_employee_key")
  @@index([organizationId, companyId, status], map: "driver_profiles_scope_status_idx")
  @@map("driver_profiles")
}

model AssistantProfile {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  companyId      String       @map("company_id") @db.Uuid
  employeeId     String       @map("employee_id") @db.Uuid
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([companyId, employeeId], map: "assistant_profiles_company_employee_key")
  @@index([organizationId, companyId, status], map: "assistant_profiles_scope_status_idx")
  @@map("assistant_profiles")
}

model ResourceDocument {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  companyId      String            @map("company_id") @db.Uuid
  branchId       String?           @map("branch_id") @db.Uuid
  ownerType      DocumentOwnerType @map("owner_type")
  vehicleId      String?           @map("vehicle_id") @db.Uuid
  employeeId     String?           @map("employee_id") @db.Uuid
  documentType   String            @map("document_type") @db.VarChar(60)
  fileId         String            @unique(map: "resource_documents_file_id_key") @map("file_id") @db.Uuid
  issuedAt       DateTime?         @map("issued_at") @db.Date
  expiresAt      DateTime?         @map("expires_at") @db.Date
  status         DocumentStatus    @default(CURRENT)
  supersedesId   String?           @unique(map: "resource_documents_supersedes_id_key") @map("supersedes_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  vehicle        Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  supersedes     ResourceDocument? @relation("DocumentRenewal", fields: [supersedesId], references: [id], onDelete: Restrict)
  renewedBy      ResourceDocument? @relation("DocumentRenewal")

  @@index([organizationId, companyId, ownerType, vehicleId, employeeId, status], map: "resource_documents_scope_owner_status_idx")
  @@index([organizationId, companyId, expiresAt], map: "resource_documents_scope_expiry_idx")
  @@map("resource_documents")
}

model MaintenancePlan {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  companyId      String      @map("company_id") @db.Uuid
  branchId       String?     @map("branch_id") @db.Uuid
  vehicleId      String      @map("vehicle_id") @db.Uuid
  name           String      @db.VarChar(100)
  intervalKm     Int?        @map("interval_km")
  intervalDays   Int?        @map("interval_days")
  windowDays     Int         @default(15) @map("window_days")
  nextDueKm      Int?        @map("next_due_km")
  nextDueAt      DateTime?   @map("next_due_at") @db.Date
  windowStartAt  DateTime?   @map("window_start_at") @db.Date
  windowEndAt    DateTime?   @map("window_end_at") @db.Date
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  vehicle        Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  records        MaintenanceRecord[]

  @@unique([vehicleId, name], map: "maintenance_plans_vehicle_name_key")
  @@index([organizationId, companyId, vehicleId, status], map: "maintenance_plans_scope_vehicle_status_idx")
  @@index([organizationId, companyId, nextDueAt], map: "maintenance_plans_scope_due_date_idx")
  @@map("maintenance_plans")
}

model MaintenanceRecord {
  id                String                 @id @default(uuid()) @db.Uuid
  organizationId    String                 @map("organization_id") @db.Uuid
  companyId         String                 @map("company_id") @db.Uuid
  branchId          String?                @map("branch_id") @db.Uuid
  vehicleId         String                 @map("vehicle_id") @db.Uuid
  planId            String?                @map("plan_id") @db.Uuid
  type              MaintenanceType
  status            MaintenanceRecordStatus @default(SCHEDULED)
  description       String                 @db.VarChar(500)
  provider          String?                @db.VarChar(120)
  scheduledAt       DateTime?              @map("scheduled_at") @db.Date
  startedAt         DateTime?              @map("started_at") @db.Timestamptz(6)
  completedAt       DateTime?              @map("completed_at") @db.Timestamptz(6)
  outOfService      Boolean                @default(false) @map("out_of_service")
  odometerKm        Int?                   @map("odometer_km")
  costAmount        Decimal?               @map("cost_amount") @db.Decimal(12, 2)
  currencyCode      String                 @default("BOB") @map("currency_code") @db.Char(3)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  vehicle           Vehicle                @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  plan              MaintenancePlan?       @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([organizationId, companyId, vehicleId, status], map: "maintenance_records_scope_vehicle_status_idx")
  @@index([organizationId, companyId, scheduledAt], map: "maintenance_records_scope_schedule_idx")
  @@map("maintenance_records")
}

model VehicleFuelTank {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  companyId      String      @map("company_id") @db.Uuid
  branchId       String?     @map("branch_id") @db.Uuid
  vehicleId      String      @map("vehicle_id") @db.Uuid
  name           String      @db.VarChar(80)
  fuelType       FuelType    @map("fuel_type")
  unit           FuelUnit
  capacity       Decimal     @db.Decimal(12, 3)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  vehicle        Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  records        FuelRecord[]

  @@unique([vehicleId, name], map: "vehicle_fuel_tanks_vehicle_name_key")
  @@unique([id, vehicleId], map: "vehicle_fuel_tanks_id_vehicle_key")
  @@index([organizationId, companyId, vehicleId, status], map: "vehicle_fuel_tanks_scope_vehicle_status_idx")
  @@map("vehicle_fuel_tanks")
}

model FuelRecord {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  companyId      String      @map("company_id") @db.Uuid
  branchId       String?     @map("branch_id") @db.Uuid
  vehicleId      String      @map("vehicle_id") @db.Uuid
  tankId         String      @map("tank_id") @db.Uuid
  fuelType       FuelType    @map("fuel_type")
  unit           FuelUnit
  quantity       Decimal     @db.Decimal(12, 3)
  costAmount     Decimal     @map("cost_amount") @db.Decimal(12, 2)
  currencyCode   String      @default("BOB") @map("currency_code") @db.Char(3)
  odometerKm     Int         @map("odometer_km")
  occurredAt     DateTime    @default(now()) @map("occurred_at") @db.Timestamptz(6)
  provider       String?     @db.VarChar(120)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  vehicle        Vehicle    @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  tank           VehicleFuelTank @relation(fields: [tankId, vehicleId], references: [id, vehicleId], onDelete: Restrict)

  @@index([organizationId, companyId, vehicleId, occurredAt], map: "fuel_records_scope_vehicle_date_idx")
  @@index([organizationId, companyId, fuelType, unit], map: "fuel_records_scope_fuel_unit_idx")
  @@map("fuel_records")
}

model Trip {
  id                     String      @id @default(uuid()) @db.Uuid
  organizationId         String      @map("organization_id") @db.Uuid
  companyId              String      @map("company_id") @db.Uuid
  branchId               String?     @map("branch_id") @db.Uuid
  type                   TripType
  status                 TripStatus  @default(PLANNED)
  vehicleId              String      @map("vehicle_id") @db.Uuid
  contractingCompanyId   String?     @map("contracting_company_id") @db.Uuid
  origin                 String      @db.VarChar(160)
  destination            String      @db.VarChar(160)
  sealNumbers            String[]    @default([]) @map("seal_numbers")
  plannedStartAt         DateTime    @map("planned_start_at") @db.Timestamptz(6)
  plannedEndAt           DateTime    @map("planned_end_at") @db.Timestamptz(6)
  actualStartAt          DateTime?   @map("actual_start_at") @db.Timestamptz(6)
  actualEndAt            DateTime?   @map("actual_end_at") @db.Timestamptz(6)
  cancelledAt            DateTime?   @map("cancelled_at") @db.Timestamptz(6)
  cancelledByActorId     String?     @map("cancelled_by_actor_id") @db.Uuid
  cancellationReason     String?     @map("cancellation_reason") @db.VarChar(300)
  createdByActorId       String      @map("created_by_actor_id") @db.Uuid
  createdAt              DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  vehicle                Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  stops                  TripStop[]
  crew                   TripCrewAssignment[]
  events                 TripEvent[]

  @@index([organizationId, companyId, status, plannedStartAt], map: "trips_scope_status_start_idx")
  @@index([vehicleId, status, plannedStartAt, plannedEndAt], map: "trips_vehicle_schedule_idx")
  @@index([contractingCompanyId], map: "trips_contracting_company_idx")
  @@map("trips")
}

model TripStop {
  id        String   @id @default(uuid()) @db.Uuid
  tripId    String   @map("trip_id") @db.Uuid
  position  Int
  location  String   @db.VarChar(160)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Restrict)

  @@unique([tripId, position], map: "trip_stops_trip_position_key")
  @@map("trip_stops")
}

model TripCrewAssignment {
  id                 String        @id @default(uuid()) @db.Uuid
  tripId             String        @map("trip_id") @db.Uuid
  role               TripCrewRole
  source             TripCrewSource
  employeeId         String?       @map("employee_id") @db.Uuid
  externalName       String?       @map("external_name") @db.VarChar(120)
  startsAt           DateTime      @map("starts_at") @db.Timestamptz(6)
  endsAt             DateTime      @map("ends_at") @db.Timestamptz(6)
  isActive           Boolean       @default(true) @map("is_active")
  createdByActorId   String        @map("created_by_actor_id") @db.Uuid
  cancelledAt        DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  cancelledByActorId String?       @map("cancelled_by_actor_id") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  trip               Trip          @relation(fields: [tripId], references: [id], onDelete: Restrict)

  @@index([tripId, isActive, startsAt], map: "trip_crew_trip_active_start_idx")
  @@index([employeeId, isActive, startsAt, endsAt], map: "trip_crew_employee_schedule_idx")
  @@map("trip_crew_assignments")
}

model TripEvent {
  id        String        @id @default(uuid()) @db.Uuid
  tripId    String        @map("trip_id") @db.Uuid
  type      TripEventType
  actorId   String        @map("actor_id") @db.Uuid
  payload   Json?
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  trip      Trip          @relation(fields: [tripId], references: [id], onDelete: Restrict)

  @@index([tripId, createdAt], map: "trip_events_trip_created_idx")
  @@map("trip_events")
}
