generator client {
  provider        = "prisma-client"
  output          = "./generated"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  PENDING_ACTIVATION
  ACTIVE
  BLOCKED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum PlatformRole {
  PLATFORM_ADMIN
}

enum ScopeType {
  ORGANIZATION
  COMPANY
  BRANCH
}

enum CatalogScope {
  GLOBAL
  ORGANIZATION
  COMPANY
}

enum SettingScopeType {
  INSTALLATION
  ORGANIZATION
  COMPANY
  BRANCH
}

enum SettingValueType {
  STRING
}

enum AccountTokenPurpose {
  ACTIVATION
  PASSWORD_RECOVERY
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum AuditActorType {
  USER
  SYSTEM
}

enum EmailDeliveryOutcome {
  SENT
  FAILED
}

enum FileStatus {
  ACTIVE
  DELETE_PENDING
}

enum FileResourceType {
  COMPANY_ATTACHMENT
  BRANCH_ATTACHMENT
  EMPLOYEE_PHOTO
  EMPLOYEE_DOCUMENT
}

model Organization {
  id          String             @id @default(uuid()) @db.Uuid
  name        String             @db.VarChar(160)
  status      OrganizationStatus @default(ACTIVE)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  companies   Company[]
  memberships OrganizationMembership[]
  roles       Role[]
  assignments RoleAssignment[]
  auditEvents AuditEvent[]
  emailOutbox EmailOutbox[]
  catalogs     Catalog[]
  settings     Setting[]
  businessHours BusinessHour[]
  numberSequences NumberSequence[]
  files        File[]
  employees    Employee[]

  @@map("organizations")
}

model Company {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  legalName      String      @map("legal_name") @db.VarChar(200)
  tradeName      String?     @map("trade_name") @db.VarChar(200)
  nit            String?     @db.VarChar(40)
  contact        String?     @db.VarChar(300)
  address        String?     @db.VarChar(500)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branches       Branch[]
  assignments    RoleAssignment[] @relation("RoleAssignmentCompany")
  auditEvents    AuditEvent[] @relation("AuditEventCompany")
  catalogs       Catalog[]
  settings       Setting[]
  businessHours  BusinessHour[]
  numberSequences NumberSequence[]
  files          File[]
  employees      Employee[]

  @@unique([id, organizationId], map: "companies_id_organization_id_key")
  @@index([organizationId, status], map: "companies_organization_status_idx")
  @@map("companies")
}

model Branch {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  companyId      String      @map("company_id") @db.Uuid
  code           String      @db.VarChar(40)
  name           String      @db.VarChar(160)
  address        String?     @db.VarChar(500)
  contact        String?     @db.VarChar(300)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  company        Company     @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Restrict)
  assignments    RoleAssignment[] @relation("RoleAssignmentBranch")
  auditEvents    AuditEvent[] @relation("AuditEventBranch")
  settings       Setting[]
  businessHours  BusinessHour[]
  numberSequences NumberSequence[]
  files          File[]
  employeeBranchAssignments EmployeeBranchAssignment[]

  @@unique([id, companyId, organizationId], map: "branches_id_company_organization_key")
  @@unique([companyId, code], map: "branches_company_code_key")
  @@index([organizationId, status], map: "branches_organization_status_idx")
  @@map("branches")
}

model User {
  id             String        @id @default(uuid()) @db.Uuid
  normalizedEmail String       @unique(map: "users_normalized_email_key") @map("normalized_email") @db.VarChar(320)
  displayName    String        @map("display_name") @db.VarChar(160)
  passwordHash   String?       @map("password_hash") @db.VarChar(500)
  status         UserStatus    @default(PENDING_ACTIVATION)
  platformRole   PlatformRole? @map("platform_role")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships    OrganizationMembership[]
  sessions       Session[]
  accountTokens  AccountToken[]
  auditEvents    AuditEvent[] @relation("AuditEventActor")
  settingsUpdated Setting[] @relation("SettingUpdatedBy")
  businessHoursUpdated BusinessHour[] @relation("BusinessHourUpdatedBy")
  numberSequencesUpdated NumberSequence[] @relation("NumberSequenceUpdatedBy")
  uploadedFiles File[] @relation("FileUploader")
  employeeDocumentsUploaded EmployeeDocument[]
  installationSmtpSettingsUpdated InstallationSmtpSetting[] @relation("InstallationSmtpSettingsUpdatedBy")

  @@map("users")
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  status         MembershipStatus @default(INVITED)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  roleAssignments RoleAssignment[]
  selectedSessions Session[]       @relation("SessionSelectedMembership")
  accountTokens   AccountToken[]   @relation("AccountTokenMembership")
  employees       Employee[]

  @@unique([organizationId, userId], map: "memberships_organization_user_key")
  @@unique([id, organizationId], map: "memberships_id_organization_id_key")
  @@unique([userId, id], map: "memberships_user_id_id_key")
  @@index([userId, status], map: "memberships_user_status_idx")
  @@map("organization_memberships")
}

model Role {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  code           String      @db.VarChar(60)
  name           String      @db.VarChar(120)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  permissions    RolePermission[]
  assignments    RoleAssignment[]

  @@unique([organizationId, code], map: "roles_organization_code_key")
  @@unique([id, organizationId], map: "roles_id_organization_id_key")
  @@index([organizationId, status], map: "roles_organization_status_idx")
  @@map("roles")
}

model Permission {
  code        String           @id @db.VarChar(100)
  description String           @db.VarChar(300)
  roleLinks   RolePermission[]

  @@map("permissions")
}

model RolePermission {
  organizationId String     @map("organization_id") @db.Uuid
  roleId         String     @map("role_id") @db.Uuid
  permissionCode String     @map("permission_code") @db.VarChar(100)
  role           Role       @relation(fields: [roleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Restrict)

  @@id([roleId, permissionCode])
  @@index([organizationId, permissionCode], map: "role_permissions_organization_permission_idx")
  @@map("role_permissions")
}

model RoleAssignment {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  membershipId   String    @map("membership_id") @db.Uuid
  roleId         String    @map("role_id") @db.Uuid
  scopeType      ScopeType @map("scope_type")
  companyId      String?   @map("company_id") @db.Uuid
  branchId       String?   @map("branch_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  membership     OrganizationMembership @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  role           Role      @relation(fields: [roleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  company        Company?  @relation("RoleAssignmentCompany", fields: [companyId, organizationId], references: [id, organizationId], onDelete: Restrict)
  branch         Branch?   @relation("RoleAssignmentBranch", fields: [branchId, companyId, organizationId], references: [id, companyId, organizationId], onDelete: Restrict)

  @@index([membershipId, organizationId], map: "role_assignments_membership_idx")
  @@index([roleId, organizationId], map: "role_assignments_role_idx")
  @@index([companyId, scopeType], map: "role_assignments_company_scope_idx")
  @@index([branchId, scopeType], map: "role_assignments_branch_scope_idx")
  @@map("role_assignments")
}

model Session {
  id                    String                 @id @default(uuid()) @db.Uuid
  userId                String                 @map("user_id") @db.Uuid
  selectedMembershipId  String?                @map("selected_membership_id") @db.Uuid
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt             DateTime               @map("expires_at") @db.Timestamptz(6)
  revokedAt             DateTime?              @map("revoked_at") @db.Timestamptz(6)
  metadata              Json?
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  selectedMembership   OrganizationMembership? @relation("SessionSelectedMembership", fields: [userId, selectedMembershipId], references: [userId, id], onDelete: Restrict)
  refreshTokens         RefreshToken[]

  // Authentication transactions revoke the previous row before inserting a new session.
  @@unique([userId], where: raw("\"revoked_at\" IS NULL"), map: "sessions_one_unrevoked_per_user")
  @@index([userId, expiresAt], map: "sessions_user_expiry_idx")
  @@map("sessions")
}

model RefreshToken {
  id          String       @id @default(uuid()) @db.Uuid
  sessionId   String       @map("session_id") @db.Uuid
  tokenHash   String       @unique(map: "refresh_tokens_token_hash_key") @map("token_hash") @db.VarChar(128)
  consumedAt  DateTime?    @map("consumed_at") @db.Timestamptz(6)
  expiresAt   DateTime     @map("expires_at") @db.Timestamptz(6)
  successorId String?      @map("successor_id") @db.Uuid
  session     Session      @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  successor   RefreshToken? @relation("RefreshTokenRotation", fields: [successorId, sessionId], references: [id, sessionId], onDelete: Restrict)
  predecessor RefreshToken? @relation("RefreshTokenRotation")

  @@unique([id, sessionId], map: "refresh_tokens_id_session_key")
  @@unique([successorId, sessionId], map: "refresh_tokens_successor_session_key")
  @@index([sessionId, expiresAt], map: "refresh_tokens_session_expiry_idx")
  @@map("refresh_tokens")
}

model AccountToken {
  id           String                 @id @default(uuid()) @db.Uuid
  userId       String                 @map("user_id") @db.Uuid
  membershipId String?                @map("membership_id") @db.Uuid
  purpose      AccountTokenPurpose
  tokenHash    String                 @unique(map: "account_tokens_token_hash_key") @map("token_hash") @db.VarChar(128)
  expiresAt    DateTime               @map("expires_at") @db.Timestamptz(6)
  consumedAt   DateTime?              @map("consumed_at") @db.Timestamptz(6)
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  user         User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  membership   OrganizationMembership? @relation("AccountTokenMembership", fields: [userId, membershipId], references: [userId, id], onDelete: Restrict)

  @@index([userId, purpose, expiresAt], map: "account_tokens_user_purpose_expiry_idx")
  @@index([membershipId, expiresAt], map: "account_tokens_membership_expiry_idx")
  @@map("account_tokens")
}

model AuthRateLimit {
  keyHash         String   @id @map("key_hash") @db.Char(64)
  windowStartedAt DateTime @default(now()) @map("window_started_at") @db.Timestamptz(6)
  attempts        Int      @default(1)

  @@map("auth_rate_limits")
}

model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  companyId      String?  @map("company_id") @db.Uuid
  branchId       String?  @map("branch_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  actorType      AuditActorType @map("actor_type")
  action         String   @db.VarChar(100)
  resourceType   String   @map("resource_type") @db.VarChar(100)
  resourceId     String?  @map("resource_id") @db.VarChar(100)
  diff           Json?
  requestId      String   @map("request_id") @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company        Company? @relation("AuditEventCompany", fields: [companyId, organizationId], references: [id, organizationId], onDelete: Restrict)
  branch         Branch? @relation("AuditEventBranch", fields: [branchId, companyId, organizationId], references: [id, companyId, organizationId], onDelete: Restrict)
  actor          User? @relation("AuditEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt], map: "audit_events_organization_created_idx")
  @@index([actorId, createdAt], map: "audit_events_actor_created_idx")
  @@map("audit_events")
}

model EmailOutbox {
  id               String      @id @default(uuid()) @db.Uuid
  organizationId   String?     @map("organization_id") @db.Uuid
  templateCode     String      @map("template_code") @db.VarChar(100)
  recipient        String      @db.VarChar(320)
  payload          Json
  deduplicationKey String      @unique(map: "email_outbox_deduplication_key_key") @map("deduplication_key") @db.VarChar(200)
  status           OutboxStatus @default(PENDING)
  attempts         Int         @default(0)
  nextAttemptAt    DateTime    @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lockedAt         DateTime?   @map("locked_at") @db.Timestamptz(6)
  lockToken        String?     @map("lock_token") @db.Uuid
  lastErrorCode    String?     @map("last_error_code") @db.VarChar(80)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  template         EmailTemplate @relation(fields: [templateCode], references: [code], onDelete: Restrict)
  deliveries       EmailDelivery[]

  @@index([status, nextAttemptAt], map: "email_outbox_status_next_attempt_idx")
  @@map("email_outbox")
}

model EmailTemplate {
  code        String       @id @db.VarChar(100)
  subject     String       @db.VarChar(200)
  textBody    String       @map("text_body") @db.Text
  variables   String[]     @db.Text
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  outboxItems EmailOutbox[]

  @@map("email_templates")
}

model EmailDelivery {
  id        String               @id @default(uuid()) @db.Uuid
  outboxId  String               @map("outbox_id") @db.Uuid
  attempt   Int
  outcome   EmailDeliveryOutcome
  errorCode String?              @map("error_code") @db.VarChar(80)
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  outbox    EmailOutbox          @relation(fields: [outboxId], references: [id], onDelete: Restrict)

  @@unique([outboxId, attempt], map: "email_deliveries_outbox_attempt_key")
  @@index([outboxId, createdAt], map: "email_deliveries_outbox_created_idx")
  @@map("email_deliveries")
}

model InstallationSmtpSetting {
  id               Int      @id @default(1) @db.SmallInt
  host             String   @db.VarChar(255)
  port             Int
  secure           Boolean  @default(false)
  requireTls       Boolean  @default(false) @map("require_tls")
  fromAddress      String   @map("from_address") @db.VarChar(320)
  username         String?  @db.VarChar(320)
  passwordEnvelope Json?    @map("password_envelope") @db.JsonB
  updatedBy        String?  @map("updated_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updater          User?    @relation("InstallationSmtpSettingsUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@map("installation_smtp_settings")
}

model Catalog {
  id             String       @id @default(uuid()) @db.Uuid
  code           String       @db.VarChar(80)
  name           String       @db.VarChar(160)
  description    String?      @db.VarChar(500)
  scope          CatalogScope
  organizationId String?      @map("organization_id") @db.Uuid
  companyId      String?      @map("company_id") @db.Uuid
  status         RecordStatus @default(ACTIVE)
  isProtected    Boolean      @default(false) @map("is_protected")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company        Company?     @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Restrict)
  items          CatalogItem[]

  @@unique([code], where: raw("\"scope\" = 'GLOBAL'"), map: "catalogs_global_code_key")
  @@unique([organizationId, code], where: raw("\"scope\" = 'ORGANIZATION'"), map: "catalogs_organization_code_key")
  @@unique([companyId, code], where: raw("\"scope\" = 'COMPANY'"), map: "catalogs_company_code_key")
  @@index([scope, status], map: "catalogs_scope_status_idx")
  @@index([organizationId, scope, status], map: "catalogs_organization_scope_status_idx")
  @@index([companyId, status], map: "catalogs_company_status_idx")
  @@map("catalogs")
}

model CatalogItem {
  id          String       @id @default(uuid()) @db.Uuid
  catalogId   String       @map("catalog_id") @db.Uuid
  code        String       @db.VarChar(80)
  name        String       @db.VarChar(160)
  description String?      @db.VarChar(500)
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  catalog     Catalog      @relation(fields: [catalogId], references: [id], onDelete: Restrict)
  employeePositions Employee[] @relation("EmployeePosition")
  employeeDocumentTypes EmployeeDocument[] @relation("EmployeeDocumentType")

  @@unique([catalogId, code], map: "catalog_items_catalog_code_key")
  @@index([catalogId, status, name], map: "catalog_items_catalog_status_name_idx")
  @@map("catalog_items")
}

model Setting {
  id             String           @id @default(uuid()) @db.Uuid
  scopeType      SettingScopeType @map("scope_type")
  organizationId String?          @map("organization_id") @db.Uuid
  companyId      String?          @map("company_id") @db.Uuid
  branchId       String?          @map("branch_id") @db.Uuid
  key            String           @db.VarChar(80)
  valueType      SettingValueType @default(STRING) @map("value_type")
  value          Json             @db.JsonB
  updatedBy      String?          @map("updated_by") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company        Company?         @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Restrict)
  branch         Branch?          @relation(fields: [branchId, companyId, organizationId], references: [id, companyId, organizationId], onDelete: Restrict)
  updater        User?            @relation("SettingUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@unique([key], where: raw("\"scope_type\" = 'INSTALLATION'"), map: "settings_installation_key_key")
  @@unique([organizationId, key], where: raw("\"scope_type\" = 'ORGANIZATION'"), map: "settings_organization_key_key")
  @@unique([companyId, key], where: raw("\"scope_type\" = 'COMPANY'"), map: "settings_company_key_key")
  @@unique([branchId, key], where: raw("\"scope_type\" = 'BRANCH'"), map: "settings_branch_key_key")
  @@index([organizationId, scopeType, key], map: "settings_organization_scope_key_idx")
  @@map("settings")
}

model BusinessHour {
  id             String           @id @default(uuid()) @db.Uuid
  scopeType      SettingScopeType @map("scope_type")
  organizationId String           @map("organization_id") @db.Uuid
  companyId      String           @map("company_id") @db.Uuid
  branchId       String?          @map("branch_id") @db.Uuid
  weekday        Int              @db.SmallInt
  intervals      Json             @db.JsonB
  updatedBy      String?          @map("updated_by") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company        Company          @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Restrict)
  branch         Branch?          @relation(fields: [branchId, companyId, organizationId], references: [id, companyId, organizationId], onDelete: Restrict)
  updater        User?            @relation("BusinessHourUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@unique([companyId, weekday], where: raw("\"scope_type\" = 'COMPANY' AND \"branch_id\" IS NULL"), map: "business_hours_company_weekday_key")
  @@unique([branchId, weekday], where: raw("\"scope_type\" = 'BRANCH'"), map: "business_hours_branch_weekday_key")
  @@index([organizationId, companyId, branchId, weekday], map: "business_hours_scope_weekday_idx")
  @@map("business_hours")
}

model NumberSequence {
  id             String    @id @default(uuid()) @db.Uuid
  scopeType      ScopeType @map("scope_type")
  organizationId String    @map("organization_id") @db.Uuid
  companyId      String?   @map("company_id") @db.Uuid
  branchId       String?   @map("branch_id") @db.Uuid
  documentType   String    @map("document_type") @db.VarChar(60)
  period         String    @db.VarChar(16)
  prefix         String    @default("") @db.VarChar(24)
  padding        Int       @default(0) @db.SmallInt
  nextValue      BigInt    @default(1) @map("next_value")
  updatedBy      String?   @map("updated_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company        Company?  @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Restrict)
  branch         Branch?   @relation(fields: [branchId, companyId, organizationId], references: [id, companyId, organizationId], onDelete: Restrict)
  updater        User?     @relation("NumberSequenceUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@unique([organizationId, documentType, period], where: raw("\"scope_type\" = 'ORGANIZATION'"), map: "number_sequences_organization_key_key")
  @@unique([companyId, documentType, period], where: raw("\"scope_type\" = 'COMPANY'"), map: "number_sequences_company_key_key")
  @@unique([branchId, documentType, period], where: raw("\"scope_type\" = 'BRANCH'"), map: "number_sequences_branch_key_key")
  @@index([organizationId, companyId, branchId, documentType], map: "number_sequences_scope_document_idx")
  @@map("number_sequences")
}

model File {
  id                String           @id @default(uuid()) @db.Uuid
  organizationId    String           @map("organization_id") @db.Uuid
  companyId         String           @map("company_id") @db.Uuid
  branchId          String?          @map("branch_id") @db.Uuid
  storageKey        String           @unique(map: "files_storage_key_key") @map("storage_key") @db.VarChar(36)
  originalName      String           @map("original_name") @db.VarChar(255)
  detectedMime      String           @map("detected_mime") @db.VarChar(100)
  bytes             BigInt
  sha256            String           @db.Char(64)
  status            FileStatus       @default(ACTIVE)
  uploadedBy        String           @map("uploaded_by") @db.Uuid
  deleteRequestedAt DateTime?        @map("delete_requested_at") @db.Timestamptz(6)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company           Company          @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Restrict)
  branch            Branch?          @relation(fields: [branchId, companyId, organizationId], references: [id, companyId, organizationId], onDelete: Restrict)
  uploader          User             @relation("FileUploader", fields: [uploadedBy], references: [id], onDelete: Restrict)
  link              FileLink?
  employeePhoto     Employee?        @relation("EmployeePhoto")
  employeeDocument  EmployeeDocument?

  @@unique([id, organizationId, companyId], map: "files_id_organization_company_key")
  @@index([organizationId, companyId, branchId, status, createdAt], map: "files_scope_status_created_idx")
  @@index([status, deleteRequestedAt], map: "files_cleanup_idx")
  @@map("files")
}

model FileLink {
  id           String           @id @default(uuid()) @db.Uuid
  fileId       String           @unique(map: "file_links_file_id_key") @map("file_id") @db.Uuid
  resourceType FileResourceType @map("resource_type")
  resourceId   String           @map("resource_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  file         File             @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([resourceType, resourceId, createdAt], map: "file_links_resource_created_idx")
  @@map("file_links")
}

model Employee {
  id                      String           @id @default(uuid()) @db.Uuid
  organizationId          String           @map("organization_id") @db.Uuid
  companyId               String           @map("company_id") @db.Uuid
  internalCode            String           @map("internal_code") @db.VarChar(60)
  firstNames              String           @map("first_names") @db.VarChar(120)
  lastNames               String           @map("last_names") @db.VarChar(120)
  personalDocumentNumber  String?          @map("personal_document_number") @db.VarChar(80)
  personalPhone           String?          @map("personal_phone") @db.VarChar(40)
  personalEmail           String?          @map("personal_email") @db.VarChar(320)
  personalAddress         String?          @map("personal_address") @db.VarChar(500)
  positionId              String?          @map("position_id") @db.Uuid
  hireDate                DateTime         @map("hire_date") @db.Date
  status                  RecordStatus     @default(ACTIVE)
  userId                  String?          @map("user_id") @db.Uuid
  photoFileId             String?          @unique(map: "employees_photo_file_id_key") @map("photo_file_id") @db.Uuid
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization            Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company                 Company          @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Restrict)
  membership              OrganizationMembership? @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Restrict)
  position                CatalogItem?     @relation("EmployeePosition", fields: [positionId], references: [id], onDelete: Restrict)
  photo                   File?            @relation("EmployeePhoto", fields: [photoFileId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)
  branchAssignments       EmployeeBranchAssignment[]
  documents               EmployeeDocument[]

  @@unique([organizationId, companyId, internalCode], map: "employees_company_internal_code_key")
  @@unique([organizationId, userId], map: "employees_organization_user_key")
  @@unique([id, organizationId, companyId], map: "employees_id_organization_company_key")
  @@unique([photoFileId, organizationId, companyId], map: "employees_photo_file_scope_key")
  @@index([organizationId, companyId, status, lastNames, firstNames], map: "employees_scope_status_name_idx")
  @@map("employees")
}

model EmployeeBranchAssignment {
  employeeId     String       @map("employee_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  companyId      String       @map("company_id") @db.Uuid
  branchId       String       @map("branch_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  employee       Employee     @relation(fields: [employeeId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)
  branch         Branch       @relation(fields: [branchId, companyId, organizationId], references: [id, companyId, organizationId], onDelete: Restrict)

  @@id([employeeId, branchId])
  @@index([organizationId, companyId, branchId, employeeId], map: "employee_branch_assignments_scope_idx")
  @@map("employee_branch_assignments")
}

model EmployeeDocument {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  companyId      String     @map("company_id") @db.Uuid
  employeeId     String     @map("employee_id") @db.Uuid
  fileId         String     @unique(map: "employee_documents_file_id_key") @map("file_id") @db.Uuid
  typeId         String     @map("type_id") @db.Uuid
  issuedAt       DateTime?  @map("issued_at") @db.Date
  expiresAt      DateTime?  @map("expires_at") @db.Date
  uploadedBy     String     @map("uploaded_by") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  employee       Employee   @relation(fields: [employeeId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)
  file           File       @relation(fields: [fileId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)
  type           CatalogItem @relation("EmployeeDocumentType", fields: [typeId], references: [id], onDelete: Restrict)
  uploader       User       @relation(fields: [uploadedBy], references: [id], onDelete: Restrict)

  @@unique([fileId, organizationId, companyId], map: "employee_documents_file_scope_key")
  @@index([employeeId, createdAt], map: "employee_documents_employee_created_idx")
  @@map("employee_documents")
}
